{
  "name": "zhiwu",
  "private": true,
  "version": "1.1.34",
  "description": "本地优先的个人物品与订阅价值管理工具",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:built": "node scripts/smoke-built.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build && npm run test:built",
    "android:sync": "npm run build && npx cap sync android",
    "capture:screenshots": "node scripts/capture-product-screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.4.3",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@material-symbols/svg-400": "^0.45.8",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "undici": "7.28.0"
  }
}
